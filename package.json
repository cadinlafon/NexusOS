{
  "name": "nexus-os",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "firebase emulators:exec --project demo-nexus --ui --import=.firebase-data --export-on-exit=.firebase-data \"vite --mode emulator\"",
    "dev:users": "node scripts/seed-dev-users.mjs",
    "ai:test": "node scripts/test-ai.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "browser:setup": "native/scripts/setup-cef.sh",
    "browser:build": "native/scripts/build.sh",
    "nexus:dev": "native/scripts/dev.sh"
  },
  "dependencies": {
    "firebase": "^13.0.0",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
