# Used by `npm run dev:local`, which runs NEXUS against the Firebase Local
# Emulator Suite on this computer. Nothing here is a secret or a real project:
# "demo-" projects only exist inside the emulator. Safe to commit.

VITE_FIREBASE_USE_EMULATOR=true
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST=127.0.0.1:8085

VITE_FIREBASE_API_KEY=demo-emulator-key
VITE_FIREBASE_AUTH_DOMAIN=demo-nexus.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-nexus
VITE_FIREBASE_STORAGE_BUCKET=demo-nexus.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=demo-nexus-app

# Password for the emulator-only test accounts made by `npm run dev:users`.
# It opens nothing outside the emulator on this computer.
NEXUS_DEV_PASSWORD=nexus-emulator-only
