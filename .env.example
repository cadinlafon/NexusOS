# Copy this file to .env and fill in your own key. Never commit .env.

# Read only by the local NEXUS AI service (ai/aiServicePlugin.mjs).
# It has no VITE_ prefix on purpose, so Vite never puts it in browser code.
OPENROUTER_API_KEY=YOUR_OPENROUTER_KEY_HERE

# The models NEXUS AI uses are listed in ai/models.json (free models only).

# Firebase (Authentication + Firestore). Copy these from the Firebase console:
# Project settings > General > Your apps > Web app > SDK setup and configuration.
# Put real values in .env.local, which Git ignores.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
